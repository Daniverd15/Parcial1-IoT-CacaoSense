{
  "@id": "dtmi:unab:cacaosense:poscosecha;1",
  "@type": "Interface",
  "@context": [
    "dtmi:iotcentral:context;2",
    "dtmi:dtdl:context;2"
  ],
  "displayName": {
    "en": "CacaoSense Poscosecha y Dosel"
  },
  "description": {
    "en": "Parcial 1 IoT UNAB 2026-II - Granja y cultivo de cacao. Plantilla v1.0.0"
  },
  "contents": [
    {
      "@type": "Telemetry",
      "name": "boxTemperature",
      "displayName": {
        "en": "Temperatura de la masa (caja)"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: Maxim DS18B20. Unidad: °C."
      },
      "displayUnit": {
        "en": "°C"
      }
    },
    {
      "@type": [
        "Telemetry",
        "NumberValue"
      ],
      "name": "temperature",
      "displayName": {
        "en": "Temperatura del aire"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: AM2302/DHT22 o Vaisala WXT530. Unidad: °C."
      },
      "displayUnit": {
        "en": "°C"
      },
      "minValue": 17,
      "maxValue": 34,
      "decimalPlaces": 1
    },
    {
      "@type": "Telemetry",
      "name": "humidity",
      "displayName": {
        "en": "Humedad relativa"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: AM2302/DHT22 o Vaisala WXT530. Unidad: % HR."
      },
      "displayUnit": {
        "en": "% HR"
      }
    },
    {
      "@type": "Telemetry",
      "name": "mass",
      "displayName": {
        "en": "Masa del lote en fermentacion"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: Celda de carga + HX711. Unidad: kg."
      },
      "displayUnit": {
        "en": "kg"
      }
    },
    {
      "@type": [
        "Telemetry",
        "NumberValue"
      ],
      "name": "illuminance",
      "displayName": {
        "en": "Iluminancia"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: ROHM BH1750FVI. Unidad: lx."
      },
      "displayUnit": {
        "en": "lx"
      },
      "minValue": 0,
      "maxValue": 45000,
      "decimalPlaces": 0
    },
    {
      "@type": "Property",
      "name": "samplingIntervalSec",
      "displayName": {
        "en": "Intervalo de envio (s)"
      },
      "schema": "integer",
      "writable": true
    },
    {
      "@type": "Property",
      "name": "firmwareVersion",
      "displayName": {
        "en": "Version del codigo"
      },
      "schema": "string",
      "writable": false
    },
    {
      "@type": "Property",
      "name": "zone",
      "displayName": {
        "en": "Zona del predio"
      },
      "schema": "string",
      "writable": false
    },
    {
      "@type": "Property",
      "name": "originId",
      "displayName": {
        "en": "Origen de envio"
      },
      "schema": "string",
      "writable": false
    },
    {
      "@type": "Command",
      "name": "setAlertLed",
      "displayName": {
        "en": "LED de alerta"
      },
      "request": {
        "@type": "CommandPayload",
        "name": "enabled",
        "displayName": {
          "en": "Activar"
        },
        "schema": "boolean"
      },
      "response": {
        "@type": "CommandPayload",
        "name": "result",
        "displayName": {
          "en": "Resultado"
        },
        "schema": "string"
      }
    }
  ]
}