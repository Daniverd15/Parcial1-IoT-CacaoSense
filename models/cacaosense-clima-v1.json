{
  "@id": "dtmi:unab:cacaosense:clima;1",
  "@type": "Interface",
  "@context": [
    "dtmi:iotcentral:context;2",
    "dtmi:dtdl:context;2"
  ],
  "displayName": {
    "en": "CacaoSense Clima y Aire"
  },
  "description": {
    "en": "Parcial 1 IoT UNAB 2026-II - Granja y cultivo de cacao. Plantilla v1.0.0"
  },
  "contents": [
    {
      "@type": [
        "Telemetry",
        "NumberValue"
      ],
      "name": "temperature",
      "displayName": {
        "en": "Temperatura del aire"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: AM2302/DHT22 o Vaisala WXT530. Unidad: °C."
      },
      "displayUnit": {
        "en": "°C"
      },
      "minValue": 17,
      "maxValue": 34,
      "decimalPlaces": 1
    },
    {
      "@type": "Telemetry",
      "name": "humidity",
      "displayName": {
        "en": "Humedad relativa"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: AM2302/DHT22 o Vaisala WXT530. Unidad: % HR."
      },
      "displayUnit": {
        "en": "% HR"
      }
    },
    {
      "@type": "Telemetry",
      "name": "rainfall",
      "displayName": {
        "en": "Lluvia del intervalo"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: Vaisala WXT530. Unidad: mm."
      },
      "displayUnit": {
        "en": "mm"
      }
    },
    {
      "@type": "Telemetry",
      "name": "windSpeed",
      "displayName": {
        "en": "Velocidad del viento"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: Vaisala WXT530. Unidad: km/h."
      },
      "displayUnit": {
        "en": "km/h"
      }
    },
    {
      "@type": "Telemetry",
      "name": "radiation",
      "displayName": {
        "en": "Radiacion solar global"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: Apogee SP-110-SS. Unidad: W/m²."
      },
      "displayUnit": {
        "en": "W/m²"
      }
    },
    {
      "@type": "Telemetry",
      "name": "pm25",
      "displayName": {
        "en": "PM2.5"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: Sensirion SPS30. Unidad: µg/m³."
      },
      "displayUnit": {
        "en": "µg/m³"
      }
    },
    {
      "@type": "Telemetry",
      "name": "pm10",
      "displayName": {
        "en": "PM10"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: Sensirion SPS30. Unidad: µg/m³."
      },
      "displayUnit": {
        "en": "µg/m³"
      }
    },
    {
      "@type": "Telemetry",
      "name": "aqi",
      "displayName": {
        "en": "Indice US AQI"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: Calculado (EPA US AQI). Unidad: indice."
      },
      "displayUnit": {
        "en": "indice"
      }
    },
    {
      "@type": "Telemetry",
      "name": "leafWetness",
      "displayName": {
        "en": "Humectacion foliar"
      },
      "schema": "double",
      "description": {
        "en": "Sensor de referencia: METER PHYTOS 31. Unidad: % tiempo mojado."
      },
      "displayUnit": {
        "en": "% tiempo mojado"
      }
    },
    {
      "@type": "Telemetry",
      "name": "sourceKind",
      "displayName": {
        "en": "Naturaleza del dato"
      },
      "schema": "string",
      "description": {
        "en": "Sensor de referencia: metadato."
      }
    },
    {
      "@type": "Telemetry",
      "name": "sourceTimestamp",
      "displayName": {
        "en": "Marca de tiempo de la fuente"
      },
      "schema": "dateTime",
      "description": {
        "en": "Sensor de referencia: metadato. Unidad: UTC."
      }
    },
    {
      "@type": "Property",
      "name": "samplingIntervalSec",
      "displayName": {
        "en": "Intervalo de envio (s)"
      },
      "schema": "integer",
      "writable": true
    },
    {
      "@type": "Property",
      "name": "firmwareVersion",
      "displayName": {
        "en": "Version del codigo"
      },
      "schema": "string",
      "writable": false
    },
    {
      "@type": "Property",
      "name": "zone",
      "displayName": {
        "en": "Zona del predio"
      },
      "schema": "string",
      "writable": false
    },
    {
      "@type": "Property",
      "name": "originId",
      "displayName": {
        "en": "Origen de envio"
      },
      "schema": "string",
      "writable": false
    }
  ]
}